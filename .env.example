# Supabase — copie para .env.local (local) ou configure no painel da Vercel.
# Sem estas duas variáveis, o sistema roda em modo local (localStorage, um aparelho).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON

# Mercado Pago — pagamento automático das assinaturas (server-side).
# MP_ACCESS_TOKEN: token de acesso da aplicação do Mercado Pago
# (obrigatório para o checkout; credenciais de teste começam com
# APP_USR). NUNCA com prefixo NEXT_PUBLIC_ — o token não pode ir
# para o navegador. Sem ele, o checkout responde erro claro em pt-BR
# e o app continua no período grátis — nada quebra por falta de token.
MP_ACCESS_TOKEN=SEU-ACCESS-TOKEN-DO-MERCADO-PAGO
# MP_WEBHOOK_SECRET: segredo da assinatura do webhook (opcional —
# gerado no painel "Suas integrações" do Mercado Pago, na
# configuração do webhook). Com ele, o webhook valida a assinatura
# HMAC (x-signature) antes de processar; sem ele, a confirmação é
# feita só pelo GET à API do Mercado Pago.
MP_WEBHOOK_SECRET=SEU-SEGREDO-DO-WEBHOOK
